-- Q10 Top 3 by total spend.
SELECT 
  c.customer_id,
  c.customer_name,
  COUNT(*) AS num_trips,
  SUM(t.fare) AS total_spend
FROM customers c
INNER JOIN trips t ON c.customer_id = t.customer_id
WHERE t.status = 'Completed'
GROUP BY c.customer_id, c.customer_name
ORDER BY total_spend DESC
LIMIT 3;

