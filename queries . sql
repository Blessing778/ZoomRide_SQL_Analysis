UPDATE trips SET city = 'Kampala' WHERE city = 'Kampla';

--  Q5 STEP 2: Remove Duplicate 
SELECT 
  customer_id, driver_id, trip_date, fare,
  MIN(trip_id) AS keep_first,
  MAX(trip_id) AS delete_later
FROM trips
GROUP BY customer_id, driver_id, trip_date, fare
HAVING COUNT(*) > 1;

--  Q5 STEP 3: Delete the later 
DELETE FROM trips WHERE trip_id IN (
  SELECT delete_id FROM (
    SELECT MAX(trip_id) AS delete_id
    FROM trips
    GROUP BY customer_id, driver_id, trip_date, fare
    HAVING COUNT(*) > 1
  ) AS d
);

SELECT customer_id, driver_id, trip_date, fare, COUNT(*) 
FROM trips 
GROUP BY customer_id, driver_id, trip_date, fare 
HAVING COUNT(*) > 1;

SELECT distinct status from trips;

-- Q6 Revenue by city
SELECT 
  city,
  COUNT(*) AS num_trips,
  SUM(fare) AS revenue,
  ROUND(AVG(fare), 2) AS avg_fare
FROM trips
WHERE status = 'Completed'
GROUP BY city
ORDER BY revenue DESC;


-- Q7 Revenue by Month
SELECT 
  DATE_FORMAT(trip_date, '%Y-%m') AS month,
  COUNT(*) AS num_trips,
  SUM(fare) AS revenue
FROM trips
WHERE status = 'Completed'
GROUP BY month
ORDER BY revenue DESC
LIMIT 1;

-- Q8 Revenu by vehicle
SELECT 
  d.vehicle_type,
  COUNT(*) AS num_trips,
  SUM(t.fare) AS total_revenue
FROM trips t
INNER JOIN drivers d ON t.driver_id = d.driver_id
WHERE t.status = 'Completed'
GROUP BY d.vehicle_type
ORDER BY total_revenue DESC;

