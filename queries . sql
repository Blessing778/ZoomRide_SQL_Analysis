-- Q4A: Find duplicate trips
SELECT 
  customer_id,
  driver_id,
  trip_date,
  fare,
  COUNT(*) AS duplicate_count
FROM trips
GROUP BY customer_id, driver_id, trip_date, fare
HAVING COUNT(*) > 1;

-- Q4b: How many Completed trips have a missing fare.
SELECT COUNT(*) AS missing_fare_count
FROM trips
WHERE status = 'Completed'
AND fare IS NULL;

